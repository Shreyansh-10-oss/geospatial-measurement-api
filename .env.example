GEOSPATIAL_APP_NAME="Geospatial File Measurement API"
GEOSPATIAL_DATABASE_URL=sqlite:///./geospatial.db
GEOSPATIAL_UPLOADS_DIR=./uploads

GEOSPATIAL_MAX_UPLOAD_BYTES=20971520
GEOSPATIAL_MAX_ZIP_UNCOMPRESSED_BYTES=104857600
GEOSPATIAL_MAX_ZIP_ENTRIES=100
GEOSPATIAL_MAX_ZIP_COMPRESSION_RATIO=200

# Total multipart request bytes, including encoding overhead.
GEOSPATIAL_MAX_REQUEST_BYTES=22020096
GEOSPATIAL_MAX_CONCURRENT_UPLOADS=2
GEOSPATIAL_MAX_FEATURES=10000
GEOSPATIAL_MAX_COORDINATES=250000
GEOSPATIAL_MAX_PROPERTY_BYTES=16384
GEOSPATIAL_MAX_KML_DEPTH=32
GEOSPATIAL_MAX_STORAGE_BYTES=536870912
GEOSPATIAL_FAILED_UPLOAD_RETENTION_DAYS=30
GEOSPATIAL_MAX_ATTRIBUTE_FIELDS=128
